# ============================================================================
# Antalya Delivery Bot — переменные окружения (см. ТЗ §13)
#
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# ВАЖНО: .env никогда не коммитится в git (см. .gitignore).
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Токен бота, выданный @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (без пробелов), напр. 111111,222222
ADMIN_TELEGRAM_IDS=

# --- Redis (FSM для aiogram + в будущем таймеры застрявших заказов) --------
# Локально: redis://localhost:6379/0
# Railway: значение из Redis add-on (переменная REDIS_URL в панели Railway)
REDIS_URL=redis://localhost:6379/0

# --- Google Sheets API -------------------------------------------------------
# Ключ service account (JSON), закодированный в base64 одной строкой:
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID документа «Меню» (мерчанты + позиции), read-only для бота
SHEETS_MENU_ID=

# ID документа «Заказы» (заказы + события + курьеры), запись бота
SHEETS_ORDERS_ID=

# --- Google Maps Geocoding API -----------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Внешний вид --------------------------------------------------------------
# URL приветственного баннера для /start. Необязательно — без него бот
# отправит текстовое приветствие без изображения.
WELCOME_IMAGE_URL=

# --- Часовой пояс и часы работы (ТЗ §6) --------------------------------------
TIMEZONE=Europe/Istanbul
SERVICE_OPEN=10:00
SERVICE_CLOSE=21:00
LAST_ORDER=20:15

# --- Тайм-ауты (ТЗ §9) --------------------------------------------------------
# Окно на принятие заказа курьером (1 круг офферов), секунды
OFFER_TIMEOUT_SEC=60
# assigned → picked_up, иначе эскалация Админу, минуты
PICKUP_TIMEOUT_MIN=15
# picked_up → delivered, иначе эскалация Админу, минуты
DELIVERY_TIMEOUT_MIN=40
# Тайм-аут подтверждения нестандартного заказа мерчантом, минуты
CUSTOM_ORDER_TIMEOUT_MIN=15

# --- Оплата (архитектурная заглушка, ТЗ §3, §5) ------------------------------
# False на MVP: статус awaiting_payment пропускается, заказ идёт в offered.
PAYMENT_ENABLED=False
# Тайм-аут ожидания оплаты до payment_expired, минуты (актуально если PAYMENT_ENABLED=True)
PAYMENT_TIMEOUT_MIN=15
# Реквизиты Papara (нужны, только если PAYMENT_ENABLED=True и не задан Iyzico)
PAPARA_BUSINESS_ID=
# Iyzico API key (приоритет над Papara, если PAYMENT_ENABLED=True)
IYZICO_API_KEY=

# --- Поддержка клиентов: антифлуд (ТЗ §7.7.6) --------------------------------
# Окно антифлуда поддержки, секунды (600 = 10 минут)
SUPPORT_FLOOD_WINDOW_SEC=600
# Макс. сообщений в поддержку за окно, дальше — "уже получено" без пуша Админу
SUPPORT_FLOOD_MAX_MESSAGES=3

# --- P2P-доставка (ТЗ §7.6) ---------------------------------------------------
# Множитель рекомендованного вознаграждения курьеру для P2P-заказов
P2P_REWARD_MULTIPLIER=2

# --- Геозона доставки (ТЗ §3A) ------------------------------------------------
# Центр зоны — координаты Антальи по умолчанию
ZONE_CENTER_LAT=36.8841
ZONE_CENTER_LON=30.7056
# Радиус зоны (вариант А — MVP), км
ZONE_RADIUS_KM=15

# --- Прочее -------------------------------------------------------------------
# TTL кеша меню/мерчантов из Google Sheets, секунды
CACHE_TTL_SECONDS=300
# Макс. количество единиц одной позиции в корзине
MAX_ITEMS_PER_TYPE=10

# Уровень логирования (не описан в ТЗ явно, добавлено для наблюдаемости в Railway)
LOG_LEVEL=INFO
